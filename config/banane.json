[
  {
    "name": "tester server",
    "host": "0.0.0.0",
    "port": 8080,
    "max_body": 1000000,
    "routes": [
      {
        "route": "/",
        "method": ["GET"],
        "directory": "./website",
        "index": "index.html"
      },
      {
        "route": "/put_test/",
        "method": ["PUT"],
        "directory": "./upload",
        "upload": "./upload"
      },
      {
        "route": "/",
        "method": ["POST"],
        "cgi": [
          {
            "extension": "bla",
            "exec": "./ubuntu_cgi_tester"
          }
        ],
        "directory": "./cgi"
      },
      {
        "route": "/post_body",
        "method": ["POST"],
        "directory": "./post_body",
        "max_body": 100
      },
      {
        "route": "/directory",
        "method": ["GET"],
        "directory": "./YoupiBanane",
        "dir_listing": true
      }
    ]
  }
]
